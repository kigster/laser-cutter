#!/usr/bin/env ruby

require File.expand_path('../lib/laser-cutter', __dir__)
require File.expand_path('../lib/laser-cutter/cli/opt_parser', __dir__)

config = Laser::Cutter::CLI::OptParser.parse(ARGV)

begin
  Laser::Cutter::Renderer::LayoutRenderer.new(config).render
  if config.open
    `open #{config.file}`
  end
rescue Exception => e
  warn "Whoops, #{e.message}".red
  if config.verbose
    warn e.backtrace.join("\n").red
  end
end
